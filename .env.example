# Copy to .env (which is git-ignored) and fill in, or set these directly in
# your host's dashboard — Render/Railway "Environment", a systemd unit, etc.
#
# Nothing here is mandatory. With none of it set the trainer registration form
# still renders, validates and stores every submission on disk; these variables
# only switch on the delivery channels and the office review pages.
# Full guide: docs/GYM_FORM.md

# ---------------------------------------------------------------------------
# Trainer registration form — who gets notified
# ---------------------------------------------------------------------------
GYM_NOTIFY_EMAIL=dulange111@gmail.com
GYM_NOTIFY_WHATSAPP=917588610829
GYM_SEND_TRAINER_COPY=1

# ---------------------------------------------------------------------------
# Email delivery — option A: Brevo (recommended, free, works everywhere)
# Sends over HTTPS, so it works on hosts that block outbound SMTP. Render's
# free tier blocks ports 25/465/587, which makes SMTP unusable there.
# Sign up at brevo.com (300 emails/day free), verify the sender address under
# Senders & IPs, then create an API key under SMTP & API -> API Keys.
# ---------------------------------------------------------------------------
# GYM_BREVO_API_KEY=
# GYM_EMAIL_FROM=dulange111@gmail.com

# ---------------------------------------------------------------------------
# Email delivery — option B: SMTP (only where outbound SMTP is allowed)
# Ignored when GYM_BREVO_API_KEY is set. For Gmail, GYM_SMTP_PASSWORD must be a
# 16-character App Password, created at Google Account -> Security -> 2-Step
# Verification -> App passwords. A normal account password is rejected.
# ---------------------------------------------------------------------------
GYM_SMTP_HOST=smtp.gmail.com
GYM_SMTP_PORT=587
GYM_SMTP_USER=
GYM_SMTP_PASSWORD=
# GYM_SMTP_FROM=
# GYM_SMTP_USE_SSL=0

# ---------------------------------------------------------------------------
# WhatsApp delivery — optional, pick ONE provider.
# With none set, the notification email carries a one-tap wa.me link instead
# of sending automatically. That costs nothing and keeps trainers' details
# between your server and your inbox.
# ---------------------------------------------------------------------------
# Option A — CallMeBot: free and automatic. WhatsApp "I allow callmebot to
# send me messages" to +34 644 51 95 23 from the receiving phone, and it
# replies with the key. Personal use only; see docs/GYM_FORM.md section 4.
# GYM_CALLMEBOT_APIKEY=

# Option B — Twilio (commercial)
# GYM_TWILIO_ACCOUNT_SID=
# GYM_TWILIO_AUTH_TOKEN=
# GYM_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option C — WhatsApp Cloud API (Meta, commercial)
# GYM_META_PHONE_NUMBER_ID=
# GYM_META_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Office review pages (/gym/admin). Until these are set, those pages return 503
# rather than exposing trainers' ID numbers and addresses.
# ---------------------------------------------------------------------------
GYM_ADMIN_USERNAME=
GYM_ADMIN_PASSWORD=

# Pin the URL encoded in the QR code, if the auto-detected one is wrong
# (custom domain, reverse proxy).
# GYM_PUBLIC_URL=https://your-host.example.com/gym

# ---------------------------------------------------------------------------
# RTU benchmarking tool (the rest of this repository)
# ---------------------------------------------------------------------------
# RTU_AUTH_USERNAME=
# RTU_AUTH_PASSWORD=
